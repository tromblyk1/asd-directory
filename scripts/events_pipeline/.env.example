# Supabase — service role key (NOT the anon key) is required for inserts/upserts
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — OPTIONAL.
# - If set, tier 2 calls the Claude API with web_search (paid, ~$0.05/week).
# - If unset, tier 2 falls back to reading `tier2_manual.json`, which you
#   generate weekly by pasting `tier2_manual_prompt.md` into claude.ai.
ANTHROPIC_API_KEY=

# Optional: override the model used for the API path
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: how many days ahead tier2 researches (default 30)
TIER2_LOOKAHEAD_DAYS=30
